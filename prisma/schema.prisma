generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      String    @default("passenger")
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id           String   @id @default(cuid())
  userId       String
  type         String
  status       String   @default("pending")
  pickupId     String?
  dropoffId    String?
  pickupTime   String?
  passengers   Int?
  fareEstimate Float?
  tourId       String?
  tourDate     String?
  guests       Int?
  totalPrice   Float?
  notes        String?
  driverName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
